# AISTROYKA E2E audit environment
# Copy to .env.e2e for local use. Do not commit .env.e2e.

# Optional. If empty, scripts/audit/run_e2e_audit.sh starts the local web app.
E2E_BASE_URL=

# Required for authenticated dashboard and sync E2E.
# If omitted, the audit runner falls back to SMOKE_EMAIL / SMOKE_PASSWORD from gitignored .env.local files.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Optional. If omitted, tests discover a project where possible.
E2E_PROJECT_ID=

# Optional. Only set if a target environment requires an additional system key.
E2E_SYSTEM_KEY=

# Defaults to ru.
E2E_LOCALE=ru

# Optional. Used only by API sync E2E to mint a Supabase user JWT via password grant.
# These must match the same Supabase project used by the target web/API environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
