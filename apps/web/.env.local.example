# Copy to .env.local and fill in from Supabase Dashboard (Project Settings → API).
# Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: service role key. If set, bucket "media" is created automatically on first upload.
# SUPABASE_SERVICE_ROLE_KEY=
# Canonical app URL (for redirects, auth redirectTo). Production: set to https://aistroyka.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stakeholder live finance sanity (`scripts/verify/stakeholder_finance_sanity.sh`)
# -----------------------------------------------------------------------------
# Invited client / external stakeholder (role stakeholder in tenant_members). NOT the same as owner/manager smoke.
# STAKEHOLDER_SMOKE_EMAIL=
# STAKEHOLDER_SMOKE_PASSWORD=
# Optional: STAKEHOLDER_FINANCE_BASE_URL=https://staging.aistroyka.ai

# -----------------------------------------------------------------------------
# Supabase CLI: live migration check (`supabase migration list`, `db push --dry-run`)
# -----------------------------------------------------------------------------
# `SUPABASE_ACCESS_TOKEN` must be a Personal Access Token from the Supabase
# account (Dashboard → Account → Access Tokens). Do NOT use anon key or
# service_role here — CLI will return Unauthorized.
# SUPABASE_ACCESS_TOKEN=
#
# Project ref = subdomain of NEXT_PUBLIC_SUPABASE_URL (e.g. xxxx in xxxx.supabase.co).
# Optional if `apps/web/supabase/.temp/project-ref` already matches after `supabase link`.
# SUPABASE_PROJECT_REF=
#
# Database password (Dashboard → Project Settings → Database). Required for remote
# migration list / dry-run when CLI connects to the linked project DB.
# SUPABASE_DB_PASSWORD=
#
# Do not put the Supabase REST URL into DATABASE_URL — Postgres drivers need:
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# (copy “Connection string” URI from the Dashboard if you need local psql.)
