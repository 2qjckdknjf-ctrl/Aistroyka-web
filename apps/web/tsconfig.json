{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@aistroyka/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@aistroyka/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@aistroyka/roma-kernel": [
        "../../packages/roma-kernel/src/index.ts"
      ],
      "@aistroyka/roma-kernel/*": [
        "../../packages/roma-kernel/src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "playwright*.config.ts",
    "audit_*",
    "audit_*/**"
  ]
}
