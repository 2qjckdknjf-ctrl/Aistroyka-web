# Copy to .env.pilot (gitignored) for `bun run audit:pilot`.
# No real secrets in this file.

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_LOCALE=en

# Auth (required for authenticated E2E)
E2E_EMAIL=
E2E_PASSWORD=
# Back-compat with existing audit scripts:
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

E2E_DEVICE_ID=e2e-device-1
E2E_DEVICE_ID_2=e2e-device-2

# Optional discovery
E2E_TENANT_ID=
E2E_PROJECT_ID=

# Pilot smoke: ops/metrics (Bearer or use SMOKE_EMAIL path in pilot_launch.sh)
# AUTH_HEADER=Bearer
# COOKIE=
SMOKE_EMAIL=
SMOKE_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cron tick when server requires secret
# CRON_SECRET=

# Optional: local stakeholder finance sanity (dedicated stakeholder account — not pilot owner)
# See docs/security/STAKEHOLDER_SMOKE_ACCOUNT_SETUP_REPORT.md
# STAKEHOLDER_SMOKE_EMAIL=
# STAKEHOLDER_SMOKE_PASSWORD=
# STAKEHOLDER_FINANCE_BASE_URL=https://aistroyka.ai

# System routes if used later
# E2E_SYSTEM_KEY=
